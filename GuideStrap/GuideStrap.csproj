<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>enable</ImplicitUsings>
    <ApplicationIcon>GuideStrap.ico</ApplicationIcon>
    <!-- UI is built in code, not the designer, so the designer-serialization check (WFO1000) doesn't apply -->
    <NoWarn>$(NoWarn);WFO1000</NoWarn>
  </PropertyGroup>

  <!-- Release builds publish as one self-contained GuideStrap.exe (no .NET install needed) -->
  <PropertyGroup Condition="'$(Configuration)' == 'Release'">
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>true</SelfContained>
    <PublishSingleFile>true</PublishSingleFile>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
    <DebugType>none</DebugType>
    <!-- pre-compiled code: GuideStrap opens faster and uses less CPU while starting -->
    <PublishReadyToRun>true</PublishReadyToRun>
  </PropertyGroup>

  <!-- every window is built in code, so open the .cs files as code instead of in the designer -->
  <ItemGroup>
    <Compile Update="**\*.cs">
      <SubType>Code</SubType>
    </Compile>
  </ItemGroup>

  <!-- the logo picture and icon, built into the .exe -->
  <ItemGroup>
    <EmbeddedResource Include="logo.png" LogicalName="GuideStrap.logo.png" />
    <EmbeddedResource Include="GuideStrap.ico" LogicalName="GuideStrap.icon.ico" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.*" />
    <PackageReference Include="DiscordRichPresence" Version="1.6.*" />
  </ItemGroup>

</Project>
